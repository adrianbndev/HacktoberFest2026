# IA (Visión + agentes de preguntas). Cualquier API compatible con OpenAI: se cambia de local a cloud
# editando estas 3 líneas, sin tocar código. Si no responde a tiempo, entra el fallback determinista.
#   Local (por defecto): Ollama  -> ollama pull qwen2.5vl:3b
#   Desde Docker con Ollama en el host: AI_BASE_URL=http://host.docker.internal:11434/v1
#   Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.5-flash
#   OpenAI: AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5vl:3b

# GitHub API para el Nivel 4 (Track C). Sube el rate-limit de 60 a 5000 req/h.
GITHUB_TOKEN=

# Conexión Next.js <-> FastAPI y persistencia (JSON local; ver .agent/architecture.md §5 para cloud)
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
STORE_FILE_PATH=./data/store.json
NEXT_PUBLIC_APP_URL=http://localhost:3000
