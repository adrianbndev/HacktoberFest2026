# ============================================================================
# Variables de Entorno — LifeOS & ReCommerce AI (Hacktoberfest 2026)
# ============================================================================

# 1. Nodo de Reconocimiento de Imágenes Local en Red (Track B — Mac de Matías 16GB RAM)
# En el Mac de Matías ejecutar: OLLAMA_HOST=0.0.0.0:11434 ollama serve
VISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelos oficiales de visión en Ollama 0.40+ (runner llama-server ggml, ideales para 16GB):
# 1) qwen2.5vl:7b (7B, ~5.9GB - SOTA en OCR y reconocimiento de productos, sin guion en 2.5vl)
# 2) minicpm-v (8B, ~5.5GB - Excelente OCR y detalles)
# 3) gemma3:12b (12B multimodal)
VISION_OLLAMA_MODEL=qwen2.5vl:7b
VISION_TIMEOUT_SEC=35.0
VISION_MAX_IMAGE_PX=896
VISION_PROVIDER=auto
# Opcional si se quiere usar OpenAI Vision como respaldo antes del fallback local:
OPENAI_API_KEY=
VISION_OPENAI_MODEL=gpt-4o-mini

# GitHub API para el Nivel 4 (Track C). Sube el rate-limit de 60 a 5000 req/h.
GITHUB_TOKEN=

# Conexión Next.js <-> FastAPI
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
# Datos en Firestore (proyecto lifeos-recommerce-hf26, plan gratuito). El backend lee la clave de servicio de
# firebase-service-account.json en la raíz del repo (nunca va al repo); descomenta solo si la guardas en otro sitio:
# FIREBASE_SERVICE_ACCOUNT=/ruta/absoluta/firebase-service-account.json
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Market valuation engine (MOD-04). All values are optional; defaults match the spec.
MARKET_ALLOW_FALLBACK=true
MARKET_JITTER_MIN_SEC=0.2
MARKET_JITTER_MAX_SEC=0.6
MARKET_CONNECTOR_TIMEOUT_SEC=1.6
MARKET_DEADLINE_SEC=2.8
MARKET_MAX_COMPARABLE_LISTINGS=12
MARKET_MIN_SAMPLE_SIZE=3

# DeepSeek recommendation (optional; a deterministic template is used without a key).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SEC=30.0
DEEPSEEK_RECOMMENDATION_BUDGET_SEC=25.0

# Browser MCP (Phase 2 deep analysis). `/api/market/valuate` is untouched.
CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1
CDP_URL=http://market-browser:9222
MARKET_ANALYSIS_ENABLED=true
# Full analysis budget and per-source/browser hard timeouts.
MARKET_ANALYSIS_DEADLINE_SEC=60
MARKET_SOURCE_TIMEOUT_SEC=25
MARKET_BROWSER_TIMEOUT_SEC=45
# Up to 4 listings per successful source in the final comparable set.
MARKET_PLATFORM_QUOTA=4
# Milanuncios result pages per analysis: 3 is the demo default, 6 maximizes
# usable samples (adds ~3-4 s per extra page).
MARKET_MILANUNCIOS_MAX_PAGES=3
# Hybrid transport: auto = HTTP first, browser fallback when HTTP is blocked,
# empty or yields fewer than 8 usable listings. `http`/`browser` force one path.
MARKET_MILANUNCIOS_TRANSPORT=auto
# Two MCP slots for eBay + Wallapop; Milanuncios HTTP does not consume a slot.
MARKET_BROWSER_POOL_SIZE=2
# Sources in flight: 2 browser + 1 HTTP.
MARKET_SOURCE_CONCURRENCY=3
# SQLite cache for real results only. `./data/...` works locally and inside Docker
# (WORKDIR /app); the compose default is /app/data/market_cache.sqlite.
MARKET_CACHE_PATH=./data/market_cache.sqlite
MARKET_CACHE_TTL_SEC=900
