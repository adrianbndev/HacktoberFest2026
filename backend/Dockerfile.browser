# Headful Chromium under Xvfb with a persistent profile (Phase 2 browser engine).
# amd64: Google Chrome stable. arm64: Debian Chromium (different fingerprint, see docs).
FROM debian:bookworm-slim

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        fonts-dejavu-core \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxshmfence1 \
        python3 \
        tini \
        x11-utils \
        xdg-utils \
        xvfb \
    && if [ "${TARGETARCH:-amd64}" = "amd64" ]; then \
        apt-get install --yes --no-install-recommends wget gnupg; \
        wget --quiet --output-document=/tmp/google-chrome.deb \
            https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; \
        apt-get install --yes /tmp/google-chrome.deb; \
        rm -f /tmp/google-chrome.deb; \
        apt-get purge --yes wget gnupg; \
        apt-get autoremove --yes; \
    else \
        apt-get install --yes --no-install-recommends chromium; \
    fi \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 browser \
    && mkdir -p /chrome-profile \
    && chown -R browser:browser /chrome-profile

COPY docker/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh
COPY docker/cdp_proxy.py /usr/local/bin/cdp_proxy.py
RUN chmod 0755 /usr/local/bin/browser-entrypoint.sh /usr/local/bin/cdp_proxy.py

USER browser
EXPOSE 9222
HEALTHCHECK --interval=10s --timeout=3s --start-period=25s --retries=6 CMD \
    curl -fsS http://127.0.0.1:9222/json/version >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-entrypoint.sh"]
